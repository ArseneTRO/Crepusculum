  m_Script: {fileID: 11500000, guid: daae47fff62a6c848a420e66a62a02e1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CE_Text
  zoomStart: 1
  zoomEnd: 2
  myCamera: {fileID: 981451307}
  cameraSpeed: 4
  shouldCameraMove: 1
  sentences: "En cet hiver de 1991, le froid prenait sa place, tant dans l\u2019environnement
    que dans mon c\u0153ur. Les oiseaux ont cess\xE9 de chanter, mes pens\xE9es se
    sont arr\xEAt\xE9es, le silence se fit. Alors, tous r\xE9unis, on \xE9coutait
    attentivement les derni\xE8res paroles que l\u2019on lui adressait."
  pauseSystem: {fileID: 0}
