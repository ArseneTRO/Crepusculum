  m_Script: {fileID: 11500000, guid: b4cf189bb9643964ba21910df7d6ea8c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Denegare
  dialogueDenied:
    name: Denegare
    sentences:
    - "Lulupin ? C'est toi ? Tu veux ma cl\xE9 ? \xC9coute, je t'ai bien aid\xE9
      par le pass\xE9 d\xE9j\xE0, et l\xE0 j'ai un creux. Je me ferais bien un ou
      deux chaussons aux pommes. Tu sais quoi ? Am\xE8ne moi 6 Chaussons au pommes
      et on discutera."
    - Tu as compris, Lulupin ? 6 Chaussons aux pommes !
    sprite: {fileID: 364449469, guid: 3a7e648c3e9cc094cb2a0f8492c41901, type: 3}
  dialogueNotEnough:
    name: Denegare
    sentences:
    - "C'est pas mal ce que tu as dans la poche... Quels bon chaussons au pommes,
      mais j'accepterais de te donner ma cl\xE9 que si tu m'en donnes 6 et pas moins
      !"
    sprite: {fileID: 364449469, guid: 3a7e648c3e9cc094cb2a0f8492c41901, type: 3}
  dialogueAccepted:
    name: Denegare
    sentences:
    - "Et bien voil\xE0 ! Je prend \xE7a, et tu prend \xE7a !"
    sprite: {fileID: 364449469, guid: 3a7e648c3e9cc094cb2a0f8492c41901, type: 3}
  dialogueAlreadyDone:
    name: Denegare
    sentences:
    - 'Et bien ? Tu as ce que tu veux, non ? '
    - "Vire toi de l\xE0."
    sprite: {fileID: -6820970681338830515, guid: ed3497224cf811e4783e70d8d2708198, type: 3}
  isInRange: 0
  boxCollider2D: {fileID: 1425589942}
