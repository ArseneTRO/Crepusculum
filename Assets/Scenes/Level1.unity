      value: Silly
      objectReference: {fileID: 0}
    - target: {fileID: 5435712953557369340, guid: 7c2a15b957c146940b7f2edfdd0c8d68, type: 3}
      propertyPath: dialogue.name
      value: Silly
      objectReference: {fileID: 0}
    - target: {fileID: 5435712953557369340, guid: 7c2a15b957c146940b7f2edfdd0c8d68, type: 3}
      propertyPath: dialogue.sprite
      value: 
      objectReference: {fileID: 5421949387354248893, guid: 08ddaa6f2520c1941855fd9cc0307304, type: 3}
    - target: {fileID: 5435712953557369340, guid: 7c2a15b957c146940b7f2edfdd0c8d68, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 5435712953557369340, guid: 7c2a15b957c146940b7f2edfdd0c8d68, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: Salut toi ! C'est pas courant de trouver du monde par ici !
      objectReference: {fileID: 0}
    - target: {fileID: 5435712953557369340, guid: 7c2a15b957c146940b7f2edfdd0c8d68, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "Je m'appelle Silly ! Je ne veux pas \xEAtre trop curieuse mais tu semblais
        r\xF4der pr\xE8s de la vieille grange, en bas ? On y garde un pr\xE9cieux
        souvenir, mais j'ai vu un chat y placer un verrou l'autre jour ... Depuis,
        elle est ferm\xE9 !"
      objectReference: {fileID: 0}
    - target: {fileID: 5435712953557369340, guid: 7c2a15b957c146940b7f2edfdd0c8d68, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "J'aurais ador\xE9 continuer de parler avec toi, mais il y as quelques
        oiseaux \xE0 faire fuir par ici ! Aller hop, hop ! Au boulot ! "
      objectReference: {fileID: 0}
    - target: {fileID: 6027793853113278513, guid: 7c2a15b957c146940b7f2edfdd0c8d68, type: 3}
      propertyPath: m_FlipX
      value: 0
      objectReference: {fileID: 0}
