  m_Script: {fileID: 11500000, guid: 3b397c19b60eae0428f191aca8aa6b2c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CE_Dialogue
  zoomStart: 0
  zoomEnd: 0
  myCamera: {fileID: 0}
  cameraSpeed: 0
  shouldCameraMove: 0
  sprite: {fileID: 608075622941810758, guid: ba382a01538178f4f9cdf8169cf94f6c, type: 3}
  sentences:
  - "NON ! JE VEUX MON P\xC8RE ! "
  - RENDS
  - 'MOI '
  - MON
  - "P\xC8RE !"
  - ...
  - "Je vous en supplie... vous qui savez tout, qui pouvez tout...  rendez-le moi.
    Je ne vous demande rien d'autre. Rien. Un homme comme vous comprend ce que vaut
    un p\xE8re. Vous le savez, n'est-ce pas ? Alors vous comprenez que je ne peux...
    que sans lui je ne.."
  - ...
  - "Pardonnez-moi. Je m'\xE9gare. Ce n'est pas ainsi qu'on vous parle."
  npcName: Vitalina
