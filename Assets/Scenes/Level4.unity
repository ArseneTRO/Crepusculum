--- !u!114 &833307557
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 833307555}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2500\u2500\u2500 R\xE9alisation \u2500\u2500\u2500\r\nTylio TARAUD\r\n\r\n\r\n\u2500\u2500\u2500
    D\xE9veloppement \u2500\u2500\u2500\r\nTylio TARAUD\r\n\r\n\r\n\u2500\u2500\u2500
    Direction artistique \u2500\u2500\u2500\r\nTylio TARAUD\r\n\r\n\r\n\u2500\u2500\u2500
    Character Design \u2500\u2500\u2500\r\nTylio TARAUD\r\n\r\n\r\n\u2500\u2500\u2500
    Level Design \u2500\u2500\u2500\r\nTylio TARAUD\r\n\r\n\r\n\u2500\u2500\u2500
    \xC9criture \u2500\u2500\u2500\r\nTylio TARAUD\r\n\r\n\r\n\u2500\u2500\u2500
    Musique \u2500\u2500\u2500\r\nNokuni - @nokuni11\nAngel - @eleazar8101\r\nBeethoven\r\n\r\n\r\n\u2500\u2500\u2500
    Polices d'\xE9criture \u2500\u2500\u2500\r\nAri W9500\r\n\r\n\r\n\u2500\u2500\u2500
    Remerciements \u2500\u2500\u2500\r\nBastien Barbaroux, Tristan Falguieres, Louis
    Celeyron, Florent Tavani, Yann Orhon, Julien Ropert, Sophie Lorgerer, Jordan
    Brooks, ainsi que tout les Jiv\xE9kistanais\n\nC\xE9cile Plot - Professeur de
    Latin\n\nMatthew Lebeau - \xE9tudiant en Psychologie\n\nTh - Playtesteur\r\n\r\nGoogle,
    Tuto Unity FR, Movix, Youtube\r\n\r\n\r\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\r\n\r\n\u2500\u2500\u2500
    Distribution \u2500\u2500\u2500\r\n\r\nVitalina .............. dans le r\xF4le
    de Vitalina\r\nAzra\xEBt ............... dans le r\xF4le de la Mort\r\nLulupin
    ............... dans le r\xF4le de Lulupin\r\nColette .... dans le r\xF4le de
    la Grand-M\xE8re\r\n\r\n\r\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\r\n\r\nAucun
    personnage n'a \xE9t\xE9 bless\xE9\r\ndurant le tournage.\r\n\r\n@..solaris.._\r\ntwitch.tv/Arsene_lives\r\n\r\nProjet
    de fin d'ann\xE9e - JV1 - ESMA 2026\r\n\r\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\r\n\r\nSi
    vous traversez une p\xE9riode difficile,\r\nle 3114 est disponible 24h/24.\r\n\r\n\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\n\r\nCREPUSCULUM\r\nby
    Ars\xE8ne - 2026\r\n\r\n\r\nVitalina will return in Avengers Doomsday"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
